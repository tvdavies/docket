// A dependency-free service for {{.Name}}. Docket starts it with the plugin
// root as cwd, PORT from service.url, and resolved instance config in
// DOCKET_PLUGIN_CONFIG. It must exit on SIGTERM.
import { createServer } from "node:http";

const port = Number(process.env.PORT || {{.Port}});
const config = JSON.parse(process.env.DOCKET_PLUGIN_CONFIG || "{}").config ?? {};

const routes = {
  "/healthz": () => ({ ok: true }),
  // Feeds the greeting setting's picker (options_from in docket-plugin.yaml):
  // an array of values, or of {value, label} objects.
  "/options/greetings": () => [
    { value: "Hello", label: "Hello" },
    { value: "Hi", label: "Hi" },
    { value: "Good day", label: "Good day (formal)" },
  ],
  "/hello": () => ({ message: `${config.greeting ?? "Hello"} from {{.Name}}`, at: new Date().toISOString() }),
};

const server = createServer((request, response) => {
  const route = routes[new URL(request.url, "http://localhost").pathname];
  response.writeHead(route ? 200 : 404, { "content-type": "application/json" });
  response.end(JSON.stringify(route ? route() : { error: "not found" }));
});
server.listen(port, "127.0.0.1", () => console.log(`{{.Name}} listening on ${port}`));
process.on("SIGTERM", () => server.close(() => process.exit(0)));
