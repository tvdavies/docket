<!doctype html>
<meta charset="utf-8">
<link rel="stylesheet" href="style.css">
<h2>{{.Title}}</h2>
<p id="context" class="muted">Connecting…</p>
{{- if .Service}}
<pre id="service">Asking the service…</pre>
{{- end}}
<script type="module">
  import { connect } from "/plugin-sdk/v1/client.js";
  const docket = await connect();
  document.getElementById("context").textContent = `Workspace ${docket.context.workspace}; capabilities: ${docket.context.capabilities.join(", ")}`;
{{- if .Service}}
  const target = document.getElementById("service");
  try {
    target.textContent = JSON.stringify(await docket.json("/hello"), null, 2);
  } catch (error) {
    target.textContent = `Service unavailable: ${error.message}`;
  }
{{- end}}
</script>
