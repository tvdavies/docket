name: {{.Name}}
version: 0.1.0
description: {{.Description}}
requires:
  docket: ">={{.MinVersion}}"
{{- if .Service}}

# Docket runs this command while the plugin is enabled in any workspace and
# restarts it when watched files change. Its output: docket plugin logs {{.Name}} -f
service:
  url: http://127.0.0.1:{{.Port}}
  healthz: /healthz
  command: [node, server/index.mjs]
  watch: ["server/**/*.mjs"]

config:
  instance:
    greeting:
      type: string
      default: Hello
      # Choices come from the service at runtime (see server/index.mjs).
      options_from: /options/greetings
      description: How the plugin greets people.
{{- end}}
{{- if .Widget}}

cli:
  run: bin/{{.Name}}
{{- end}}

ui:
  dir: ui
  capabilities: [{{.Capabilities}}]
{{- if .Widget}}
  widgets:
    - type: {{.Name}}/status
      title: {{.Title}}
      entry: widget.html
      slots: [board, activity]
{{- end}}
{{- if .Panel}}
  panels:
    - id: panel
      title: {{.Title}}
      entry: panel.html
{{- end}}
{{- if .Page}}
  pages:
    - id: overview
      title: {{.Title}}
      entry: page.html
{{- end}}
