#!/bin/sh
# Publishes a hello-widget/greeting record on a task:
#   docket hello-widget TASK-0001 [WORKSPACE]
# The collapsed card is declarative; "Expand" opens ui/widget.html.
set -eu
task=${1:?usage: docket hello-widget TASK-ID [WORKSPACE]}
workspace=${2:-$(basename "${DOCKET_HOME:-$PWD}")}
url=${DOCKET_URL:-http://127.0.0.1:7463}
now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
curl -fsS -X POST "$url/api/workspaces/$workspace/tasks/$task/widgets/create" \
  -H 'Content-Type: application/json' -H 'X-Docket-Actor: hello-widget' \
  --data "{\"version\":1,\"widget_type\":\"hello-widget/greeting\",\"instance_id\":\"hello\",\"task_id\":\"$task\",\"created_at\":\"$now\",\"revision\":1,\"phase\":\"created\",\"fallback\":{\"label\":\"Hello\",\"status_label\":\"Waving\",\"priority\":\"active\",\"summary\":\"A sandboxed widget from examples/plugins/hello-widget.\"}}"
echo
